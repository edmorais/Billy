{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Billy",
  "version": "1.0.0-rc.2",
  "identifier": "io.github.edmorais.billy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Billy",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob: thumb: http://thumb.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Eduardo Morais",
    "copyright": "Copyright (c) 2026 Eduardo Morais",
    "shortDescription": "Browse and read the PDFs in your folders",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium.dll": "pdfium.dll",
      "resources/pdfium-LICENSE.txt": "licenses/pdfium-LICENSE.txt",
      "licenses/": "licenses/",
      "../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "../LICENSE": "licenses/Billy-LICENSE.txt"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1RDNBMkM1MTAwM0FGNjYKUldSbXJ3TVF4YUxUQlFDTE5LeEVOM1BiMDBLWVlPb2hqTHVPRFRXSVdIMjFPWkF4RFhBWktYdVoK",
      "endpoints": ["https://github.com/edmorais/Billy/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
